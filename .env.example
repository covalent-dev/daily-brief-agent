# Cloud LLM (Groq)
GROQ_API_KEY=__set_me__
GROQ_MODEL=llama-3.1-8b-instant

# API surface protection (recommended)
DAILYBRIEF_ACCESS_TOKEN=__set_me__

# Scheduling (used by the Fly.io deployment)
DAILYBRIEF_SCHEDULE_ENABLED=true
DAILYBRIEF_TZ=America/Chicago
DAILYBRIEF_RUN_HHMM=07:00

# Paths (override for local dev)
DAILYBRIEF_CONFIG_PATH=./config/feeds.yaml
DAILYBRIEF_OUTPUT_DIR=./output

# LLM provider selection: "groq" or "ollama"
DAILYBRIEF_LLM_PROVIDER=groq
